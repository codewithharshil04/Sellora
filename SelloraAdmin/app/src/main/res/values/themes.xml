<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.SelloraAdmin" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/sellora_primary</item>
        <item name="colorOnPrimary">@color/sellora_white</item>
        <item name="colorPrimaryContainer">@color/sellora_white</item>
        <item name="colorOnPrimaryContainer">@color/sellora_primary</item>
        <item name="colorSurface">@color/sellora_white</item>
        <item name="colorOnSurface">@color/sellora_dark</item>
        <item name="colorOutline">@color/sellora_gray_300</item>
        <item name="android:statusBarColor">@color/sellora_primary</item>
        <item name="android:windowBackground">@color/sellora_bg_default</item>
        <item name="colorControlActivated">@color/sellora_primary</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="materialButtonStyle">@style/Admin.Button.Primary</item>
    </style>

    <style name="Theme.SelloraAdmin" parent="Base.Theme.SelloraAdmin" />

    <style name="Admin.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/switzer</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="android:stateListAnimator">@animator/button_elevation</item>
    </style>

    <style name="Admin.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/sellora_primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:fontFamily">@font/switzer</item>
    </style>

    <style name="Admin.Button.Danger" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/sellora_error</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/switzer</item>
    </style>

    <style name="BottomNavIndicatorNone" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">0dp</item>
        <item name="android:height">0dp</item>
        <item name="shapeAppearance">@null</item>
        <item name="android:color">@android:color/transparent</item>
        <item name="color">@android:color/transparent</item>
    </style>

    <style name="ShapeAppearanceOverlay.Material3.Corner.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

</resources>
