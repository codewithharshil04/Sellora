<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/sellora_white"
    app:strokeWidth="1dp"
    app:strokeColor="@color/sellora_gray_200">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top row: avatar + info + status chip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:textColor="@color/sellora_white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/switzer"
                android:background="@drawable/bg_primary_rounded_14"
                android:layout_marginEnd="12dp"
                android:text="P"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/sellora_text_dark"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/switzer"
                    android:text="Partner Name"/>

                <TextView
                    android:id="@+id/txtEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/sellora_text_gray"
                    android:textSize="13sp"
                    android:fontFamily="@font/switzer"
                    android:text="email@example.com"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chipStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_status_badge">

                <View
                    android:id="@+id/dotStatus"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/ic_status_dot"
                    android:layout_marginEnd="6dp"/>

                <TextView
                    android:id="@+id/txtStatusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active"
                    android:textSize="12sp"
                    android:fontFamily="@font/switzer"
                    android:textColor="#065F46"/>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/sellora_gray_100"
            android:layout_marginVertical="10dp"/>

        <!-- Bottom row: phone + action button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtPhone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/sellora_gray_500"
                android:textSize="13sp"
                android:fontFamily="@font/switzer"
                android:text="No phone"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggle"
                style="@style/Admin.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Deactivate"
                android:textSize="12sp"
                android:paddingHorizontal="14dp"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
