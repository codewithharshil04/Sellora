<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sellora_bg_default"
    android:fitsSystemWindows="true">

    <!-- Top Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/sellora_primary"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="90dp"
            android:layout_height="28dp"
            android:src="@drawable/logo_sellora_light"
            android:scaleType="fitStart"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin"
            android:textColor="@color/sellora_gray_400"
            android:textSize="13sp"
            android:fontFamily="@font/switzer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageButton
            android:id="@+id/btnLogout"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Logout"
            app:tint="@color/sellora_white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scroll Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Welcome -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Overview"
                android:textColor="@color/sellora_text_dark"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/switzer"
                android:layout_marginBottom="16dp" />

            <!-- Stats Grid Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="12dp">

                <!-- Users Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardUsers"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/stat_card_1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center_horizontal|center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Clients"
                            android:textColor="#388E3C"
                            android:textSize="13sp"
                            android:fontFamily="@font/switzer" />

                        <TextView
                            android:id="@+id/txtUserCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="#1B5E20"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/switzer" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Partners Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardPartners"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/stat_card_2">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center_horizontal|center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Partners"
                            android:textColor="#1565C0"
                            android:textSize="13sp"
                            android:fontFamily="@font/switzer" />

                        <TextView
                            android:id="@+id/txtPartnerCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="#0D47A1"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/switzer" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Stats Grid Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="20dp">

                <!-- Services Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardServices"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/stat_card_3">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center_horizontal|center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Services"
                            android:textColor="#F57F17"
                            android:textSize="13sp"
                            android:fontFamily="@font/switzer" />

                        <TextView
                            android:id="@+id/txtServiceCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="#E65100"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/switzer" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Orders Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardOrders"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/stat_card_4">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center_horizontal|center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Orders"
                            android:textColor="#C62828"
                            android:textSize="13sp"
                            android:fontFamily="@font/switzer" />

                        <TextView
                            android:id="@+id/txtOrderCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="#B71C1C"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/switzer" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Revenue + Order breakdown -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/sellora_primary"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Platform Revenue (after 10% fee)"
                        android:textColor="#99FFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="@font/switzer" />

                    <TextView
                        android:id="@+id/txtRevenue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹—"
                        android:textColor="@color/sellora_white"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/switzer"
                        android:layout_marginBottom="16dp" />

                    <!-- Mini stats row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Pending" android:textColor="#99FFFFFF" android:textSize="11sp" android:fontFamily="@font/switzer"/>
                            <TextView android:id="@+id/txtPendingCount" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="—"
                                android:textColor="@color/sellora_warning" android:textSize="22sp"
                                android:textStyle="bold" android:fontFamily="@font/switzer"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Delivered" android:textColor="#99FFFFFF" android:textSize="11sp" android:fontFamily="@font/switzer"/>
                            <TextView android:id="@+id/txtDeliveredCount" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="—"
                                android:textColor="@color/sellora_success" android:textSize="22sp"
                                android:textStyle="bold" android:fontFamily="@font/switzer"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Cancelled" android:textColor="#99FFFFFF" android:textSize="11sp" android:fontFamily="@font/switzer"/>
                            <TextView android:id="@+id/txtCancelledCount" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="—"
                                android:textColor="@color/sellora_error" android:textSize="22sp"
                                android:textStyle="bold" android:fontFamily="@font/switzer"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:background="@color/sellora_white"
        app:backgroundTint="@null"
        app:menu="@menu/menu_admin_bottom_nav"
        app:labelVisibilityMode="labeled"
        app:itemIconSize="24dp"
        app:itemIconTint="@color/bottom_nav_selector"
        app:itemTextColor="@color/bottom_nav_selector"
        app:itemActiveIndicatorStyle="@style/BottomNavIndicatorNone"
        app:elevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
