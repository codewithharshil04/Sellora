<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/sellora_white"
    app:strokeWidth="1dp"
    app:strokeColor="@color/sellora_gray_200">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top: image + info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgService"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:scaleType="centerCrop"
                android:src="@drawable/img_placeholder_service"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Material3.Corner.Medium"
                android:layout_marginEnd="12dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtServiceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/sellora_text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/switzer"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text="Service Name"/>

                <TextView
                    android:id="@+id/txtPartnerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/sellora_primary"
                    android:textSize="12sp"
                    android:fontFamily="@font/switzer"
                    android:text="Partner Name"
                    android:layout_marginTop="2dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/txtCategory"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/sellora_gray_400"
                        android:textSize="12sp"
                        android:fontFamily="@font/switzer"
                        android:text="Category"/>

                    <View
                        android:id="@+id/viewStatusDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/ic_status_dot"
                        android:backgroundTint="@color/sellora_gray_300"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/sellora_gray_100"
            android:layout_marginVertical="10dp"/>

        <!-- Bottom: price + actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/sellora_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/switzer"
                android:text="₹0–₹0"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggle"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Deactivate"
                android:textSize="12sp"
                android:textColor="@color/sellora_primary"
                app:strokeColor="@color/sellora_primary"
                app:strokeWidth="1dp"
                app:cornerRadius="10dp"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                style="@style/Admin.Button.Danger"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Delete"
                android:textSize="12sp"
                android:paddingHorizontal="12dp"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
