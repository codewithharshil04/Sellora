<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="10dp"
    android:paddingHorizontal="4dp"
    android:gravity="center_vertical">

    <View
        android:id="@+id/vDot"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_green_circle"/>

    <TextView
        android:id="@+id/txtDeliverable"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Deliverable item"
        android:textSize="14sp"
        android:textColor="@color/sellora_text_gray"/>

    <TextView
        android:id="@+id/txtTierBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:textColor="@color/sellora_primary"
        android:background="@drawable/bg_chip_light"
        android:visibility="gone"/>

</LinearLayout>
