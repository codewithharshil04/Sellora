<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/sellora_bg_default">

    <!-- Top bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/sellora_white"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            app:tint="@color/sellora_text_dark"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Partner Profile"
            android:textColor="@color/sellora_text_dark"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/switzer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Profile header card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/sellora_white"
                app:strokeWidth="1dp"
                app:strokeColor="@color/sellora_gray_200">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <!-- Avatar -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgPartnerPhoto"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/ic_profile_placeholder"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                        app:strokeWidth="1.5dp"
                        app:strokeColor="@color/sellora_gray_200"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Info Container -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp"
                        app:layout_constraintStart_toEndOf="@id/imgPartnerPhoto"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/imgPartnerPhoto"
                        app:layout_constraintBottom_toBottomOf="@id/imgPartnerPhoto">

                        <TextView
                            android:id="@+id/txtPartnerName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Partner Name"
                            android:textColor="@color/sellora_text_dark"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/switzer" />

                        <TextView
                            android:id="@+id/txtUsername"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@username"
                            android:textColor="@color/sellora_primary"
                            android:textSize="14sp"
                            android:fontFamily="@font/switzer"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Bio -->
                    <TextView
                        android:id="@+id/txtBio"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/sellora_text_gray"
                        android:textSize="14sp"
                        android:fontFamily="@font/switzer"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginTop="16dp"
                        android:maxLines="3"
                        android:ellipsize="end"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@id/imgPartnerPhoto"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/txtMoreBio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="more"
                        android:textColor="@color/sellora_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/switzer"
                        android:layout_marginTop="4dp"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@id/txtBio"
                        app:layout_constraintStart_toStartOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Services label -->
            <TextView
                android:id="@+id/txtServicesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Services"
                android:textColor="@color/sellora_text_dark"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="@font/switzer"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp"
                android:visibility="gone"/>

            <ProgressBar
                android:id="@+id/servicesProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone"/>

            <!-- Services list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvServices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:scrollbars="none"
                android:visibility="gone"/>

            <!-- Other partners label -->
            <TextView
                android:id="@+id/txtOtherPartnersLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Other Freelancers"
                android:textColor="@color/sellora_text_dark"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="@font/switzer"
                android:layout_marginStart="20dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:visibility="gone"/>

            <!-- Other partners horizontal list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOtherPartners"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:clipToPadding="false"
                android:scrollbars="none"
                android:visibility="gone"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>