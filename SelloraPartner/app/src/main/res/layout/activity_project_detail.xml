<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sellora_bg_default"
    android:fitsSystemWindows="true">

    <!-- Top Bar - Added fitsSystemWindows here to push content down -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sellora_white"
        android:fitsSystemWindows="true"
        app:liftOnScroll="false"
        app:elevation="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingHorizontal="8dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/sellora_text_primary"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Project Details"
                style="@style/TextAppearance.Sellora.Title"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnBack"
                android:layout_marginStart="8dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/sellora_bg_default"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Service Image -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Sellora.Card"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                app:cardElevation="0dp">
                <ImageView
                    android:id="@+id/imgService"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/img_placeholder_service"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Info Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Sellora.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:id="@+id/txtServiceName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Service Name"
                            style="@style/TextAppearance.Sellora.Title"
                            android:textSize="20sp"
                            android:layout_marginEnd="12dp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/txtStatus" />

                        <TextView
                            android:id="@+id/txtStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="In Progress"
                            style="@style/TextAppearance.Sellora.Label"
                            android:textColor="@color/sellora_white"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:background="@drawable/bg_status_badge"
                            app:layout_constraintTop_toTopOf="@id/txtServiceName"
                            app:layout_constraintEnd_toEndOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Details Rows -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Client Row -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Client"
                                style="@style/TextAppearance.Sellora.Body"
                                android:textSize="14sp"
                                android:drawableStart="@drawable/ic_profile"
                                android:drawablePadding="12dp"
                                android:drawableTint="@color/sellora_text_tertiary"
                                android:layout_centerVertical="true" />
                            <TextView
                                android:id="@+id/txtClientName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Client Name"
                                style="@style/TextAppearance.Sellora.Body"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true" />
                        </RelativeLayout>

                        <!-- Date Row -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Project Date"
                                style="@style/TextAppearance.Sellora.Body"
                                android:textSize="14sp"
                                android:drawableStart="@drawable/ic_projects"
                                android:drawablePadding="12dp"
                                android:drawableTint="@color/sellora_text_tertiary"
                                android:layout_centerVertical="true" />
                            <TextView
                                android:id="@+id/txtDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Date"
                                style="@style/TextAppearance.Sellora.Body"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true" />
                        </RelativeLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/sellora_gray_100"
                            android:layout_marginVertical="12dp" />

                        <!-- Price Row -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Earning Amount"
                                style="@style/TextAppearance.Sellora.Body"
                                android:textSize="14sp"
                                android:layout_centerVertical="true" />
                            <TextView
                                android:id="@+id/txtPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹0"
                                style="@style/TextAppearance.Sellora.Title"
                                android:textColor="@color/sellora_primary"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true" />
                        </RelativeLayout>

                        <!-- Timer Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="16dp"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Time Remaining"
                                style="@style/TextAppearance.Sellora.Body"
                                android:textSize="14sp" />
                            <TextView
                                android:id="@+id/txtTimer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="00:00:00"
                                style="@style/TextAppearance.Sellora.Body"
                                android:textColor="@color/sellora_error"
                                android:textStyle="bold"
                                android:background="@drawable/bg_chip_light"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        <!-- Requirement File Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Client Requirements"
            style="@style/TextAppearance.Sellora.Title"
            android:textSize="18sp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="12dp" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardRequirementFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/sellora_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txtRequirementFileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No requirements file uploaded"
                    style="@style/TextAppearance.Sellora.Body"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDownloadRequirement"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:text="@string/btn_open_requirements"
                    android:textAllCaps="false"
                    android:textColor="@color/sellora_primary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="16dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Delivery Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Project Delivery"
                style="@style/TextAppearance.Sellora.Title"
                android:textSize="18sp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUploadFile"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Choose Delivery File"
                app:icon="@drawable/ic_attachment"
                app:iconPadding="8dp"
                app:iconSize="24dp"
                app:iconGravity="textStart"
                android:textAllCaps="false"
                app:cornerRadius="16dp" />

            <TextView
                android:id="@+id/txtUploadedFileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="16dp"
                android:background="@drawable/bg_chip_light"
                android:text="selected_file.zip"
                style="@style/TextAppearance.Sellora.Body"
                android:textColor="@color/sellora_primary"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarkDelivered"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="16dp"
                android:text="Complete Delivery"
                android:textAllCaps="false"
                style="@style/Widget.Material3.Button"
                app:backgroundTint="@color/sellora_success"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewDelivery"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="16dp"
                android:text="@string/btn_view_delivery"
                android:textAllCaps="false"
                android:visibility="gone"
                app:cornerRadius="16dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>