<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:openDrawer="end">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/sellora_bg_default"
        android:fitsSystemWindows="true">

        <!-- Header Section -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/sellora_primary"
            app:liftOnScroll="false"
            app:elevation="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/headerContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="40dp">

                <ImageView
                    android:id="@+id/imgLogoHeader"
                    android:layout_width="120dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="24dp"
                    android:src="@drawable/logo_sellora_light"
                    android:scaleType="fitStart"
                    android:contentDescription="@string/content_description_logo"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <LinearLayout
                    android:id="@+id/headerActions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginEnd="20dp"
                    app:layout_constraintTop_toTopOf="@id/imgLogoHeader"
                    app:layout_constraintBottom_toBottomOf="@id/imgLogoHeader"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnMenu"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#20FFFFFF"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_cat"
                            android:contentDescription="@string/content_description_menu"
                            app:tint="@color/sellora_white"/>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <TextView
                    android:id="@+id/txtWelcome"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_back"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/sellora_white"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="28dp"
                    android:layout_marginEnd="20dp"
                    android:letterSpacing="-0.02"
                    app:layout_constraintTop_toBottomOf="@id/imgLogoHeader"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintVertical_chainStyle="packed"/>

                <TextView
                    android:id="@+id/txtSubtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/your_business_at_a_glance"
                    android:textSize="14sp"
                    android:textColor="@color/sellora_white_80"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginTop="2dp"
                    app:layout_constraintTop_toBottomOf="@id/txtWelcome"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>



            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- Content Section -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:behavior_overlapTop="40dp"
                android:fillViewport="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:background="@android:color/transparent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/dashboardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="20dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <!-- Background for content area below cards -->
                    <View
                        android:id="@+id/bgContent"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:background="@color/sellora_bg_default"
                        app:layout_constraintTop_toBottomOf="@id/statsContainer"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/statsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginHorizontal="20dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        app:layout_constraintTop_toTopOf="parent">

                        <!--
                            ROW 1: Two equal-width cards side by side
                        -->

                        <!-- Card: New Orders -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardNew"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="6dp"
                            app:cardBackgroundColor="@color/sellora_white"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/sellora_gray_200"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/cardDelivered">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="16dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/new_orders"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/sellora_text_dark"
                                    android:gravity="center"
                                    android:letterSpacing="-0.01"/>
                                <TextView
                                    android:id="@+id/txtNewCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/zero_amount"
                                    android:textSize="26sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/sellora_primary"
                                    android:layout_marginTop="6dp"/>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Card: Delivered -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardDelivered"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="6dp"
                            app:cardBackgroundColor="@color/sellora_white"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/sellora_gray_200"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toEndOf="@id/cardNew"
                            app:layout_constraintEnd_toEndOf="parent">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="16dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/delivered"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/sellora_text_dark"
                                    android:gravity="center"
                                    android:letterSpacing="-0.01"/>
                                <TextView
                                    android:id="@+id/txtDeliveredCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/zero_amount"
                                    android:textSize="26sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/sellora_primary"
                                    android:layout_marginTop="6dp"/>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!--
                            ROW 2: Cancelled — full width below row 1
                        -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardCancelled"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="6dp"
                            app:cardBackgroundColor="@color/sellora_white"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/sellora_gray_200"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            app:layout_constraintTop_toBottomOf="@id/cardNew"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:padding="16dp">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/status_cancelled"
                                        style="@style/TextAppearance.Sellora.Label"/>
                                    <TextView
                                        android:id="@+id/txtCancelledCount"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/zero_amount"
                                        style="@style/TextAppearance.Sellora.Title"
                                        android:layout_marginTop="4dp"/>
                                </LinearLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!--
                            ROW 3: Total Income — dark card, full width
                        -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardIncome"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="4dp"
                            app:strokeWidth="0dp"
                            app:cardBackgroundColor="@color/sellora_dark"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            app:layout_constraintTop_toBottomOf="@id/cardCancelled"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="20dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/total_earnings"
                                    style="@style/TextAppearance.Sellora.Label"
                                    android:textColor="#B0FFFFFF"/>
                                <TextView
                                    android:id="@+id/txtTotalIncome"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/zero_amount"
                                    android:textSize="28sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/sellora_white"
                                    android:layout_marginTop="4dp"/>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- My Services Header -->
                    <TextView
                        android:id="@+id/txtYourService"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/my_services"
                        style="@style/TextAppearance.Sellora.Title"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="12dp"
                        android:layout_marginTop="32dp"
                        app:layout_constraintTop_toBottomOf="@id/statsContainer"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/btnAddService"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddService"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/add_new"
                        android:layout_marginEnd="20dp"
                        app:cornerRadius="12dp"
                        app:layout_constraintTop_toTopOf="@id/txtYourService"
                        app:layout_constraintBottom_toBottomOf="@id/txtYourService"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <!-- Empty State -->
                    <TextView
                        android:id="@+id/txtNoServices"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="40dp"
                        android:visibility="gone"
                        android:text="@string/no_services_active"
                        style="@style/TextAppearance.Sellora.Title"
                        android:textColor="@color/sellora_text_secondary"
                        app:drawableTopCompat="@drawable/ic_category"
                        app:drawableTint="@color/sellora_primary"
                        android:drawablePadding="16dp"
                        app:layout_constraintTop_toBottomOf="@id/txtYourService"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        tools:visibility="visible"/>

                    <!-- Services RecyclerView -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvServices"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:layout_marginTop="12dp"
                        android:nestedScrollingEnabled="false"
                        app:layout_constraintTop_toBottomOf="@id/txtYourService"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        tools:listitem="@layout/service_card"/>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Side Drawer -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/navDrawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/sellora_white"
        android:paddingBottom="40dp">

        <View
            android:id="@+id/drawerHeader"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="@color/sellora_primary"
            app:layout_constraintTop_toTopOf="parent"/>

        <ImageView
            android:id="@+id/btnCloseDrawer"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/content_description_close"
            app:tint="@color/sellora_white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/sellora_white"
            style="@style/TextAppearance.Sellora.Title"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintBottom_toBottomOf="@id/drawerHeader"
            app:layout_constraintStart_toStartOf="parent"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/drawerHeader">
            <TextView android:id="@+id/navDashboard"  style="@style/DrawerItemStyle" android:text="@string/dashboard" />
            <TextView android:id="@+id/navAddService" style="@style/DrawerItemStyle" android:text="@string/add_new_service" />
            <TextView android:id="@+id/navProjects"   style="@style/DrawerItemStyle" android:text="@string/my_projects"      />
            <TextView android:id="@+id/navProfile"    style="@style/DrawerItemStyle" android:text="@string/profile_settings" />
            <TextView android:id="@+id/navLogout"     style="@style/DrawerItemStyle" android:text="@string/logout"
                android:textColor="@color/sellora_error"

                app:drawableTint="@color/sellora_error"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.drawerlayout.widget.DrawerLayout>