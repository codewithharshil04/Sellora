<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sellora_bg_default">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="40dp">

        <!-- Header Surface for visual depth -->
        <View
            android:id="@+id/profileHeaderBg"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:background="@color/sellora_primary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- ── Profile Card ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProfile"
            style="@style/Sellora.Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="60dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp">

                <!-- Avatar circle with camera badge -->
                <FrameLayout
                    android:id="@+id/avatarContainer"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgAvatar"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:src="@drawable/ic_profile_placeholder"
                        android:scaleType="centerCrop"
                        app:strokeColor="@color/sellora_gray_100"
                        app:strokeWidth="4dp"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Material3.Corner.Full" />

                    <!-- Camera Badge -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        app:cardCornerRadius="16dp"
                        app:cardBackgroundColor="@color/sellora_primary"
                        app:strokeWidth="0dp"
                        android:layout_gravity="bottom|end">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/i_camera"
                            android:layout_gravity="center"
                            app:tint="@color/sellora_white" />
                    </com.google.android.material.card.MaterialCardView>

                </FrameLayout>

                <!-- Name -->
                <TextView
                    android:id="@+id/txtName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="John Deo"
                    style="@style/TextAppearance.Sellora.Title"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/avatarContainer"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Username -->
                <TextView
                    android:id="@+id/txtUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@john_deo111"
                    style="@style/TextAppearance.Sellora.Body"
                    android:layout_marginTop="2dp"
                    app:layout_constraintTop_toBottomOf="@id/txtName"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- PAN Chip-like view -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/panContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/sellora_gray_100"
                    app:layout_constraintTop_toBottomOf="@id/txtUsername"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/txtPan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PAN: SLXPS1528F"
                        style="@style/TextAppearance.Sellora.Label"
                        android:textColor="@color/sellora_text_secondary"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"/>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUpdateProfile"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:text="Edit Profile"
                    android:textAllCaps="false"
                    android:layout_marginTop="24dp"
                    app:cornerRadius="14dp"
                    app:layout_constraintTop_toBottomOf="@id/panContainer"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Total Income Card (premium look) ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardIncome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/sellora_dark"
            app:layout_constraintTop_toBottomOf="@id/cardProfile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL EARNINGS"
                    style="@style/TextAppearance.Sellora.Label"
                    android:textColor="#B0FFFFFF"/>

                <TextView
                    android:id="@+id/txtTotalIncome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹0.00"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/sellora_white"
                    android:layout_marginTop="4dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWithdraw"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Request Payout"
                    android:textAllCaps="false"
                    android:textColor="@color/sellora_white"
                    android:layout_marginTop="20dp"
                    app:strokeColor="@color/sellora_white"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="14dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Menu Card ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMenu"
            style="@style/Sellora.Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/cardIncome"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <TextView
                    android:id="@+id/rowMyServices"
                    style="@style/DrawerItemStyle"
                    android:text="My Services"
                    android:drawableEnd="@drawable/ic_next"
                    android:drawablePadding="16dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="20dp"
                    android:background="@color/sellora_gray_100"/>

                <TextView
                    android:id="@+id/rowMyProjects"
                    style="@style/DrawerItemStyle"
                    android:text="My Projects"
                    android:drawableEnd="@drawable/ic_next" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="20dp"
                    android:background="@color/sellora_gray_100"/>

                <TextView
                    android:id="@+id/rowPaymentMethods"
                    style="@style/DrawerItemStyle"
                    android:text="Payment Methods"
                    android:drawableEnd="@drawable/ic_next" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="20dp"
                    android:background="@color/sellora_gray_100"/>

                <!-- Contact Admin Row -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/rowContactAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_contact_admin"
                        android:textColor="@color/sellora_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/icNextAdmin" />

                    <ImageView
                        android:id="@+id/icNextAdmin"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_next"
                        app:tint="@color/sellora_primary"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Logout"
            android:textAllCaps="false"
            android:textColor="@color/sellora_error"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/cardMenu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>